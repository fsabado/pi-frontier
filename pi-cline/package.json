{
  "name": "pi-cline",
  "version": "0.1.2",
  "description": "Cline provider extension for pi",
  "type": "module",
  "license": "MIT",
  "author": "sudosubin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudosubin/pi-frontier.git",
    "directory": "pi-cline"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "cline"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc",
    "test": "tsx --test $(find test -name '*.test.ts' -o -name '*.test.mts' -o -name '*.test.js' | sort)",
    "record:fixtures": "node --experimental-strip-types scripts/record-cline-fixtures.ts"
  },
  "dependencies": {
    "openai": "^6.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.10",
    "cline": "^2.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": ">=0.49.0",
    "@mariozechner/pi-coding-agent": ">=0.49.0"
  }
}
